{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "frontend": "vite",
        "backend": "php artisan serve",
        "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
        "test": "php artisan test",

        "test:db:up": "docker-compose -f docker/local-test-database/docker-compose.test-db.yml up -d",
        "test:db:down": "docker-compose -f docker/local-test-database/docker-compose.test-db.yml down",

        "dev:rebuild": "scripts\\run.bat development rebuild",
        "dev:cleanup": "scripts\\run.bat development cleanup",
        "dev:test": "scripts\\run.bat development test",

        "prod:reload": "bash scripts/run.sh production reload",
        "prod:cleanup": "bash scripts/run.sh production cleanup",
        "prod:debugbar:enable": "bash scripts/run.sh production enable_debugbar",
        "prod:debugbar:disable": "bash scripts/run.sh production disable_debugbar",

        "dev:encrypt": "bash scripts/run.sh development encrypt-envs",
        "dev:decrypt": "bash scripts/run.sh development decrypt-envs"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.10",
        "@tailwindcss/typography": "^0.5.16",
        "alpinejs": "^3.14.8",
        "autoprefixer": "^10.4.21",
        "axios": "^1.8.3",
        "concurrently": "^9.1.2",
        "jquery": "^3.7.1",
        "laravel-vite-plugin": "^1.2.0",
        "lodash": "^4.17.21",
        "postcss": "^8.5.3",
        "postcss-import": "^16.1.0",
        "sass": "^1.86.3",
        "tailwindcss": "^3.4.17",
        "vite": "^6.2.1"
    },
    "dependencies": {
        "@alpinejs/mask": "^3.14.8",
        "@fortawesome/fontawesome-free": "^6.7.2",
        "@themesberg/tailwind-datepicker": "^1.1.0",
        "bootstrap": "^5.3.3",
        "flowbite": "^3.1.2",
        "livewire": "^0.6.1",
        "pikaday": "^1.8.2"
    }
}
