{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "frontend": "vite",
        "backend": "php artisan serve",
        "dev": "concurrently \"npm run backend\" \"npm run frontend\"",

        "test:db:up": "docker-compose -f docker/local-test-database/docker-compose.test-db.yml up -d",
        "test:db:down": "docker-compose -f docker/local-test-database/docker-compose.test-db.yml down",

        "dev:reload": "cd scripts/development && reload.bat",
        "dev:cleanup": "cd scripts/development && cleanup.bat",
        "dev:test": "cd scripts/development && test.bat",

        "prod:reload": "cd scripts/production && bash reload.sh",
        "prod:cleanup": "cd scripts/production && bash cleanup.sh",
        "prod:debugbar:enable": "cd scripts/production && bash enable_debugbar.sh",
        "prod:debugbar:disable": "cd scripts/production && bash disable_debugbar.sh"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.10",
        "@tailwindcss/typography": "^0.5.16",
        "alpinejs": "^3.14.8",
        "autoprefixer": "^10.4.21",
        "axios": "^1.8.3",
        "concurrently": "^9.1.2",
        "jquery": "^3.7.1",
        "laravel-vite-plugin": "^1.2.0",
        "lodash": "^4.17.21",
        "postcss": "^8.5.3",
        "postcss-import": "^16.1.0",
        "sass": "^1.86.3",
        "tailwindcss": "^3.4.17",
        "vite": "^6.2.1"
    },
    "dependencies": {
        "@alpinejs/mask": "^3.14.8",
        "@fortawesome/fontawesome-free": "^6.7.2",
        "@themesberg/tailwind-datepicker": "^1.1.0",
        "bootstrap": "^5.3.3",
        "flowbite": "^3.1.2",
        "livewire": "^0.6.1",
        "pikaday": "^1.8.2"
    }
}
